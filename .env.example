# fixture = deterministic synthetic responses; live = real configured services, no silent fallback
APP_MODE=fixture
# Keep false while preparing integrations. Live outbox writes require explicit enablement.
ENABLE_EXTERNAL_WRITES=false
DATABASE_URL=sqlite:///./runtime/commerceops.db
APP_TOKEN=replace-with-a-long-random-local-password
PUBLIC_BASE_URL=http://localhost:8000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SHOPIFY_SHOP=
# For new Dev Dashboard apps: fill Client ID and Client Secret. Token is obtained automatically.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional override for an existing valid Admin API access token:
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=2026-10
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=
# Comma separated Slack member IDs authorized to approve
SLACK_APPROVER_IDS=
# HubSpot Service Key or existing legacy private-app token:
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_OWNER_ID=
# Use a service account. Share the spreadsheet with its client_email.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_RANGE=Events!A:H
MIN_CART_VALUE=25
RECOVERY_COOLDOWN_HOURS=72
HIGH_SPEND_THRESHOLD=500
HIGH_SPEND_CURRENCY=USD
WORKER_ENABLED=true
USE_N8N_FOR_DEMO=false
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
